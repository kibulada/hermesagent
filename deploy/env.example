# =============================================================================
# Hermes QA — environment untuk deploy non-Windows (VPS).
#
# Salin ke /etc/hermes-qa/hermes-qa.env, isi nilainya, lalu:
#     chmod 600 /etc/hermes-qa/hermes-qa.env
#     chown root:root /etc/hermes-qa/hermes-qa.env
#
# JANGAN commit file hasil isiannya. File ini (env.example) HANYA berisi
# placeholder — kalau kamu menemukan nilai asli di sini, itu insiden.
#
# Urutan resolusi kredensial (hermes_config.py:get_token):
#     os.environ  ->  config.yaml  ->  config/.env
# Env var di file ini menang atas dua sumber lain.
# =============================================================================

# --- 1. Override path (WAJIB di Linux) ---------------------------------------
# Di Windows tiga konstanta ini default ke %LOCALAPPDATA% / D:\. Di Linux
# LOCALAPPDATA tidak ada, jadi ketiganya HARUS di-set eksplisit atau resolusi
# kredensial diam-diam gagal.
#   hermes_config.py:24  DEFAULT_CONFIG_PATH
#   hermes_config.py:25  CUSTOM_ENV_PATH
#   mcp_launcher.py:37   DEFAULT_MCP_DIR
HERMES_CONFIG_PATH=/etc/hermes-qa/config.yaml
HERMES_CUSTOM_ENV=/etc/hermes-qa/custom.env
HERMES_MCP_DIR=/opt/hermes-qa/integrations/mcp-servers

# --- 2. OpenProject ----------------------------------------------------------
# OP_API_TOKEN adalah satu-satunya env yang dipanggil lewat env_required():
# kalau kosong, discord_bot.py mati saat start (bukan jalan dengan hasil kosong).
#
# Perhatikan penamaannya: yang diisi di sini adalah nama sisi PIPELINE.
# mcp_launcher.py (TOKEN_MAP) menerjemahkannya sebelum menjalankan server MCP:
#     OP_API_TOKEN  ->  OPENPROJECT_API_KEY
#     OP_BASE_URL   ->  OPENPROJECT_URL
# Jangan mengisi OPENPROJECT_* di file ini - launcher tidak membacanya.
# (GitLab tidak punya penerjemahan: nama di kedua sisi sama.)
OP_BASE_URL=https://tracker.kesia.id
OP_API_TOKEN=

# Status tujuan saat AC lulus. Default 16 (Tested Dev).
# HANYA boleh 11/13/16/17 — 12 (Closed) dan 14 (Rejected) bukan wewenang QA.
OP_PASS_STATUS_ID=16

# --- 3. GitLab ---------------------------------------------------------------
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# --- 4. Discord --------------------------------------------------------------
DISCORD_TOKEN=
KIBUL_DISCORD_ID=394740825260556288

# Shared secret HMAC-SHA256 untuk webhook OpenProject.
# Kalau dikosongkan, verify_signature() melewatkan verifikasi — endpoint jadi
# terbuka. Di VPS yang punya IP publik ini WAJIB diisi.
#   generate: openssl rand -hex 32
WEBHOOK_SECRET=

# --- 5. Hermes LLM gateway ---------------------------------------------------
# discord_bot.py:call_hermes_api() menembak ke sini untuk generate test code.
# Kalau hermes-agent jalan sebagai container di host yang sama, pakai nama
# service-nya, bukan localhost.
HERMES_API_URL=http://127.0.0.1:20128/v1/chat/completions
HERMES_API_KEY=

# --- 6. Playwright -----------------------------------------------------------
# WAJIB, dan nilainya harus sama persis dengan yang dipakai bootstrap_vps.sh.
# Kalau kosong, Playwright mencari browser di ~/.cache/ms-playwright milik user
# yang menjalankan service - direktori itu tidak pernah terisi (browser dipasang
# sebagai root) dan tetap diblokir ProtectHome=true di unit systemd.
PLAYWRIGHT_BROWSERS_PATH=/opt/hermes-qa/.ms-playwright

# --- 7. Staging --------------------------------------------------------------
# CATATAN: empat var ini TIDAK dibaca dari sini. playwright.config.ts memuatnya
# lewat dotenv dari automation/simrs_e2e_playwright/.env.staging.
# Lihat deploy/README.md langkah 4.
#   STAGING_BASE_URL / STAGING_TEST_USERNAME
#   STAGING_TEST_PASSWORD / STAGING_TEST_TENANT
